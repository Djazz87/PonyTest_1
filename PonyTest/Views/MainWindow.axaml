<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PonyTest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PonyTest.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PonyTest">
    
    <Grid RowDefinitions="* Auto Auto *"
          ColumnDefinitions="* Auto *">
        <TextBox Grid.Column="1" Grid.Row="1" Watermark="Имя" Text="{Binding Username}"></TextBox>
        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
            <ComboBox PlaceholderText="Выбери" HorizontalAlignment="Left" Width="190" ItemsSource="{Binding TestData}"
                      SelectedItem="{Binding SelectedTestData}"
                      DisplayMemberBinding="{Binding Title}">
                
            </ComboBox>
            <Button Command="{Binding StartTestCommand}" HorizontalAlignment="Right">Start Test</Button>
        </StackPanel>
    </Grid>
        
</Window>
